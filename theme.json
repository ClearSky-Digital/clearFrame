{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "720px", "wideSize": "1120px" },
    "color": {
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#1f2933" },
        { "slug": "paper", "name": "Paper", "color": "#ffffff" },
        { "slug": "mist", "name": "Mist", "color": "#f3f6f9" },
        { "slug": "accent", "name": "Accent", "color": "#0b5cab" },
        { "slug": "muted", "name": "Muted", "color": "#52606d" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "system", "name": "System", "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif" }
      ]
    },
    "spacing": {
      "units": [ "px", "em", "rem", "%", "vw" ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--system)" }
  }
}
